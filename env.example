# ============================================================
# GitNotate v7.4 — modèle de configuration
# Copiez ce fichier en « .env » dans le dossier du script, puis remplissez-le :
#   Windows (PowerShell) : Copy-Item env.example .env
#   Linux                : cp env.example .env
# Ne partagez et ne commitez JAMAIS le fichier .env (il est exclu par .gitignore).
#
# Les valeurs indiquées sont les valeurs par défaut du code ; jetons et ID sont à remplir.
# Une variable absente prend aussi sa valeur par défaut.
# - Écrivez les commentaires sur leur propre ligne, jamais en fin de ligne.
# - Interrupteurs : écrivez true ou false (1/0, yes/no, oui/non, on/off sont aussi acceptés) ;
#   une valeur VIDE vaut false ; toute autre valeur arrête le run (code 1) avant tout appel réseau
#   (sauf REQUIRE_LLM, qui n'est désactivé que par false).
# - Les options --dry-run, --max-repos et --log-level priment sur ce fichier.
# ============================================================


# ============================================================
# JETONS ET CLÉS API
# ============================================================

# Notion, script principal (obligatoire). Jeton d'intégration interne, commence par « ntn_ »
# (les anciens jetons « secret_ » restent valides). Créez l'intégration sur
# https://www.notion.so/my-integrations avec les capacités « Read content » + « Insert content »
# seulement : sans « Update content », elle ne peut ni modifier ni supprimer quoi que ce soit.
# Connectez-la à la page source ET à la base (dans Notion : ••• → Connexions → votre intégration).
NOTION_TOKEN=

# GitHub (facultatif ; sans jeton : 60 requêtes GitHub par heure).
# Jeton « fine-grained » avec l'accès « Public repositories (read-only) », ou jeton classique
# SANS aucune portée cochée. N'accordez pas la portée « repo » : le script ne fait que lire.
# Un jeton invalide ou expiré arrête le run (code 1) : régénérez-le ou videz la ligne.
GITHUB_TOKEN=

# Mistral AI : fournisseur LLM principal (clé à créer dans la console Mistral, rubrique API Keys).
MISTRAL_API_KEY=

# OpenRouter : fournisseur de secours, facultatif (https://openrouter.ai → Keys).
OPENROUTER_API_KEY=


# ============================================================
# IDENTIFIANTS NOTION
# ============================================================
# Un ID = les 32 caractères hexadécimaux à la fin de l'URL (avant « ?v= » pour une base).
# Exemple FICTIF : https://www.notion.so/Ma-page-0123456789abcdef0123456789abcdef
#                → 0123456789abcdef0123456789abcdef
# Indiquez l'ID seul, jamais l'URL complète.

# Page source contenant les liens GitHub (obligatoire).
PARENT_PAGE_ID=

# Base de destination (obligatoire, même en simulation). Elle doit exister et être connectée
# à l'intégration. Vide ou illisible : arrêt (code 1), aucune base n'est créée à votre place.
DATABASE_ID=

# Première installation seulement : true crée UNE base « Ressources GitHub » dans la page source
# (si DATABASE_ID est vide ; jamais en simulation), affiche son ID et s'arrête sans importer.
# Recopiez alors l'ID dans DATABASE_ID et remettez false.
CREATE_DATABASE=false


# ============================================================
# FOURNISSEURS LLM (description FR, cas d'usage, catégorie, jugements ; la note 0-10
# est calculée par le script à partir de ces jugements)
# ============================================================

# Ordre d'essai, séparé par des virgules : le premier disponible est le principal, le suivant
# sert de secours. Valeurs possibles : mistral, openrouter. Un fournisseur sans clé est ignoré.
LLM_PROVIDERS=mistral,openrouter

# Modèle Mistral : Mistral Small 4 (modèle hybride à raisonnement). Une ancienne valeur de la v7.1
# (mistral-small-2503, mistral-small-latest) reste prioritaire : un avertissement le signale.
MISTRAL_MODEL=mistral-small-2603

# Modèle OpenRouter. « openrouter/free » est le routeur gratuit : un modèle gratuit est tiré au
# hasard à chaque requête (le modèle réellement servi est noté dans la Justification).
# Quotas gratuits OpenRouter : 20 requêtes/min et 50 requêtes/jour tant que moins de 10 $ de
# crédits ont été achetés (remise à zéro à minuit UTC).
# Ancien nom : TRANSLATION_MODEL, lu seulement si OPENROUTER_MODEL est vide (avec un avertissement).
# Le modèle est vérifié au démarrage sans consommer de quota (liste publique des modèles) :
# s'il est introuvable, OpenRouter est écarté du run (piste : OPENROUTER_MODEL=openrouter/free).
OPENROUTER_MODEL=openrouter/free

# Mode reprise : aucune fiche sans réponse LLM valide ; le dépôt est reporté (rien n'est écrit)
# et repris au run suivant. false = ancien comportement (fiche avec un score lexical).
REQUIRE_LLM=true

# TRANSLATION_ENABLED=false : aucun appel LLM, score lexical uniquement (REQUIRE_LLM sans effet).
# LLM_SCORING_ENABLED=false : le LLM ne fait que traduire, la note est lexicale (Cas d'usage
#   « Non vérifié », ni Catégorie ni Brique pour, note de 8 au plus faute de Brique pour).
TRANSLATION_ENABLED=true
LLM_SCORING_ENABLED=true

# Budget de sortie par appel, raisonnement compris (minimum 16).
LLM_MAX_TOKENS=3000
# Timeout des appels LLM, en secondes.
LLM_TIMEOUT=120
# Échecs consécutifs avant de désactiver un fournisseur pour le reste du run.
LLM_BREAKER_THRESHOLD=3

# Débit maximal côté client, en requêtes par minute (0 = sans limite).
# 18 reste sous la limite gratuite d'OpenRouter (20/min).
OPENROUTER_RPM=18
MISTRAL_RPM=60

# Réglages avancés Mistral.
# Format de réponse : json_object ou none.
MISTRAL_RESPONSE_FORMAT=json_object
# Valeur envoyée en reasoning_effort (none = sans raisonnement, high = avec).
# Ligne présente mais vide : le paramètre n'est pas envoyé.
MISTRAL_REASONING_EFFORT=none

# Format de réponse demandé à OpenRouter : none, json_object ou json_schema (schéma strict).
OPENROUTER_RESPONSE_FORMAT=none

# Confidentialité OpenRouter (voir aussi les réglages Privacy de votre compte OpenRouter).
# true envoie les en-têtes HTTP-Referer et X-OpenRouter-Title « GitNotate », ce qui rend
# l'application visible publiquement chez OpenRouter. Laissez false.
OPENROUTER_ATTRIBUTION=false
# deny : seuls les fournisseurs qui ne collectent pas les données sont utilisés (moins de modèles
# gratuits). Vide ou allow : rien n'est envoyé, les réglages du compte s'appliquent.
OPENROUTER_DATA_COLLECTION=


# ============================================================
# COMPORTEMENT
# ============================================================

# Simulation : GitHub et le LLM sont appelés, mais rien n'est écrit dans Notion (option --dry-run).
DRY_RUN=false

# Ne traiter que les N premiers dépôts uniques de la page source, déjà présents compris
# (0 = tous ; option --max-repos N).
MAX_REPOS=0

# Nombre maximal de nouvelles fiches par run (0 = illimité) ; au-delà, les dépôts restants sont
# reportés au run suivant, sans appel GitHub.
MAX_NEW_PER_RUN=0

# Ignorer les dépôts non mis à jour depuis N jours (0 = désactivé ; l'env.example de la v7.1 mettait 180).
MIN_UPDATE_DAYS=0

# Note minimale (0 à 10) pour créer une fiche. 0 recommandé : tout est importé et vous triez
# dans Notion. Un dépôt écarté par ce seuil n'est pas mémorisé et repasse au LLM à chaque run.
# Une fiche non notée (dépôt sans description, sans topics et sans README exploitable : Pertinence
# vide) n'est jamais écartée par ce seuil. Sans « Brique pour », la note est de 8 au plus (repli
# lexical compris) : un seuil de 9 ou 10 écarte tous ces dépôts.
SCORE_MIN_THRESHOLD=0

# Verbosité : quiet (erreurs seulement), normal ou verbose (option --log-level).
LOG_LEVEL=normal

# Nombre de dépôts traités en parallèle (minimum 1).
MAX_WORKERS=5


# ============================================================
# PROFIL DE PERTINENCE (optionnel)
# ============================================================
# Objet JSON sur une seule ligne. Vide : fichier user_profile.json du dossier du script,
# sinon profil par défaut intégré. La source utilisée est affichée au démarrage.
# Une valeur valide remplace entièrement le fichier ; invalide, elle est ignorée (avertissement).
# Profil v2 (contexte, environnement, domaines, projets...) ou v1 (5 listes) : voir le README,
# section « Profil de pertinence ».
# Exemple : USER_PROFILE_JSON={"languages":["Python"],"frameworks":["FastAPI"],"domains":["education"],"interests":["automation"],"infra":["Docker"]}
USER_PROFILE_JSON=


# ============================================================
# CACHE GITHUB ET README
# ============================================================

# Cache local des métadonnées GitHub (.gitnotate_cache.json) ; durée de vie d'une entrée en heures.
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# README_MAX_CHARS : caractères du README nettoyé gardés dans le cache (Installation, Exemple et
# Prérequis sont extraits du README complet, avant cette limite).
# README_LLM_CHARS : caractères de ce README nettoyé envoyés au LLM (0 = README non envoyé).
README_MAX_CHARS=2500
README_LLM_CHARS=1500


# ============================================================
# RÉSEAU
# ============================================================

# Timeout des requêtes Notion, en secondes (minimum 1).
HTTP_TIMEOUT=60
# Tentatives par requête Notion ou GitHub (minimum 1). Une création de fiche n'est jamais
# renvoyée après un timeout (pas de doublon).
MAX_RETRIES=3
# Plafond de toute attente imposée par une limite de débit, en secondes ;
# au-delà, la requête échoue tout de suite au lieu d'attendre.
MAX_WAIT_SECONDS=120


# ============================================================
# NETTOYEUR DE DOUBLONS (clean_page_duplicates.py)
# ============================================================
# Il utilise aussi PARENT_PAGE_ID. Il ne lit PAS DRY_RUN : il simule toujours, sauf avec
# --apply suivi de la phrase de confirmation.

# Jeton d'une intégration Notion DÉDIÉE au nettoyeur, capacités « Read content » +
# « Update content » (nécessaire pour mettre un bloc à la corbeille), connectée à la page source.
# Vide : NOTION_TOKEN est utilisé, avec un avertissement.
NOTION_CLEANER_TOKEN=

# Nombre maximal de suppressions par exécution ; au-delà, abandon complet sans rien supprimer (code 2).
CLEANER_MAX_DELETE=50


# ============================================================
# REDÉCOUVERTE (redecouverte.py) — recherche hors ligne dans vos fiches
# ============================================================
# Il utilise aussi DATABASE_ID, HTTP_TIMEOUT, MAX_RETRIES, MAX_WAIT_SECONDS et LOG_LEVEL, et, avec
# l'option --llm seulement, les réglages LLM ci-dessus. PARENT_PAGE_ID n'est pas nécessaire.
# Mode d'emploi : docs/REDECOUVERTE.md.

# Jeton d'une intégration Notion en LECTURE SEULE (capacité « Read content » uniquement),
# connectée à la base (••• → Connexions). Recommandé : Notion refuse alors toute écriture.
# Vide = NOTION_TOKEN (le bilan de « sync » le signale par une ligne « Conseil »).
NOTION_READONLY_TOKEN=

# Nombre de dépôts affichés par recherche (1 à 50 ; l'option -n prime).
REDECOUVERTE_RESULTATS=10

# Avis LLM facultatif (option --llm) : nombre de dépôts envoyés (1 à 15 ; --llm-max prime).
REDECOUVERTE_LLM_MAX=8
# Une valeur hors de ces bornes arrête « sync » et « cherche » (code 1) avant tout appel réseau.


# ============================================================
# À DÉFINIR DANS L'ENVIRONNEMENT DU SYSTÈME, PAS DANS CE FICHIER
# ============================================================
# GITNOTATE_DATA_DIR  : dossier de .env, user_profile.json, cache, statistiques,
#                       .gitnotate_state.json, journaux et copie locale de redecouverte.py
#                       (.gitnotate_index) ; défaut : dossier du script.
# GITNOTATE_NO_DOTENV : si elle a une valeur « vraie » (1, true, yes...), le fichier .env n'est
#                       pas lu (utilisée par les tests) ; vide, 0, false, no, non ou off : lu.
