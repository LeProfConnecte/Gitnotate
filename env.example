# ============================================================
# GitNotate v6.8 — Configuration .env
# Copiez ce fichier en ".env" et remplissez vos valeurs.
# NE commitez JAMAIS ce fichier sur GitHub.
# ============================================================

# ============================================================
# TOKENS & CLÉS API (obligatoires)
# ============================================================

# Token d'intégration Notion (commence par secret_...)
# Obtenir : https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token GitHub Personal Access Token (commence par ghp_...)
# Obtenir : https://github.com/settings/tokens → Classic → scope: repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API OpenRouter pour la traduction IA (commence par sk-or-v1-...)
# Obtenir : https://openrouter.ai → Keys → Create key
# Laisser vide pour désactiver la traduction
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

MISTRAL_API_KEY=votre_clé_mistral_ici
MISTRAL_MODEL=mistral-small-latest   # facultatif, c'est la valeur par défaut


# ============================================================
# IDs NOTION (obligatoires)
# ============================================================

# ID de la PAGE SOURCE contenant les liens GitHub à analyser
# Exemple URL : https://www.notion.so/Ma-Page-1cab36ca5523800292cad5f59ab1fc0c
# → PARENT_PAGE_ID = 1cab36ca5523800292cad5f59ab1fc0c
PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la BASE DE DONNÉES de destination
# Laissez vide (ou commentez) pour création automatique à la première exécution
# Exemple URL : https://www.notion.so/2e8b36ca552381888439cb17eff24c83?v=...
# → DATABASE_ID = 2e8b36ca552381888439cb17eff24c83
DATABASE_ID=

# ============================================================
# PERFORMANCE & CONCURRENCE
# ============================================================

# Nombre de threads parallèles (recommandé : 3-5)
# ⚠️ Valeur > 5 peut déclencher le rate limit OpenRouter (20 req/min FREE)
MAX_WORKERS=5

# ============================================================
# TRADUCTION IA
# ============================================================

# Activer/désactiver la traduction automatique EN→FR
TRANSLATION_ENABLED=true

# Modèle OpenRouter à utiliser
# Modèles gratuits disponibles :
#   openai/gpt-oss-20b:free          (recommandé)
#   google/gemma-2-9b-it:free
#   meta-llama/llama-3.1-8b-instruct:free
TRANSLATION_MODEL=openai/gpt-oss-20b:free

# ============================================================
# CACHE GITHUB (v6.7+)
# ============================================================

# Activer le cache JSON des métadonnées GitHub
# Évite de re-fetcher les repos déjà analysés → +50% vitesse
CACHE_ENABLED=true

# Durée de vie du cache en heures (défaut: 24h)
# Le fichier .gitnotate_cache.json sera rechargé après ce délai
CACHE_TTL_HOURS=24

# ============================================================
# FILTRES
# ============================================================

# Mode simulation : analyse sans aucune écriture dans Notion
# ✅ Toujours tester avec DRY_RUN=true avant une première exécution
DRY_RUN=false

# Ignorer les repos non mis à jour depuis X jours (0 = désactivé)
# Recommandé : 180 (6 mois) ou 365 (1 an) pour éliminer les projets abandonnés
MIN_UPDATE_DAYS=180

# Score de pertinence minimum pour insérer dans Notion (0 = tous acceptés)
# Recommandé : 3 pour filtrer les repos non pertinents
# Plage : 0-10
SCORE_MIN_THRESHOLD=0

# ============================================================
# HTTP & RÉSEAU (v6.8+)
# ============================================================

# Timeout HTTP par requête en secondes (défaut: 60)
# Réduire à 20-30 si votre réseau est rapide pour éviter les blocages longs
HTTP_TIMEOUT=60

# Nombre de tentatives retry en cas d'erreur (défaut: 3)
MAX_RETRIES=3

# ============================================================
# ANALYSE CONTENU (v6.8+)
# ============================================================

# Longueur maximale du README analysé en caractères (défaut: 2500)
# Réduire à 1500 si lenteur sur les gros projets
README_MAX_CHARS=2500

# ============================================================
# LOGS & DÉBOGAGE (v6.8+)
# ============================================================

# Niveau de verbosité des logs
#   quiet   → erreurs seulement (mode production silencieux)
#   normal  → comportement standard (recommandé)
#   verbose → détails complets : cache hits, rate limits, timeouts
LOG_LEVEL=normal

# ============================================================
# PROFIL UTILISATEUR (optionnel)
# ============================================================

# Profil JSON inline pour personnaliser le scoring de pertinence
# Alternative : créer un fichier user_profile.json dans le même dossier
# Exemple :
# USER_PROFILE_JSON={"languages":["Python","Go"],"frameworks":["FastAPI","Gin"],"domains":["ai","devops"],"interests":["monitoring","automation"]}
USER_PROFILE_JSON=
