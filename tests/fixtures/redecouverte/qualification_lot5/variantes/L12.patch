+def composer(concepts: List[Concept]) -> List[Concept]:
+    """Compositions du lexique (lexique.COMPOSITIONS) : un concept et un mot hors lexique de la même requête
+    deviennent le concept composé, à la place du premier et avec son rôle (« recherche sémantique » + « code »
+    -> recherche_code). Le mot absorbé ne cherche plus seul : sa surface, jointe par une espace, ne produit aucun
+    terme (« code » seul trouverait n'importe quelle fiche qui en parle)."""
+    lex = lexique_compile()
+    for cid, mots, compose in lexique.COMPOSITIONS:
+        base = next((c for c in concepts if c.lexique == cid), None)
+        libres = [c for c in concepts if c.lexique is None and c.cle in mots]
+        if base is None or not libres or any(c.lexique == compose for c in concepts):
+            continue
+        nouveau = Concept(compose, compose, [' '.join([*base.surface, *(c.cle for c in libres)])],
+                          [' + '.join([base.nom, *(c.nom for c in libres)])], lex.classes[compose], base.role)
+        concepts = [nouveau if c is base else c for c in concepts if c not in libres]
+    return concepts
+
