+def _proposition(texte: str, a: int, b: int) -> Tuple[int, int]:
+    """Bornes de la proposition (entre deux _BORNES) qui contient [a, b)."""
+    debut = max((m.end() for m in _BORNES.finditer(texte, 0, a)), default=0)
+    m = _BORNES.search(texte, b)
+    return debut, (m.start() if m else len(texte))
+
+
+def sorte_mention(texte: str, a: int, b: int, colonne: str, nature: str) -> str:
+    """Ce qu'une occurrence [a, b) d'un identifiant exclu dit de lui (lexique, « Exclusion d'un identifiant ») :
+    'requis', 'non_requis' ou 'mention' (ni l'un ni l'autre). Les valeurs de colonnes (Catégorie, Brique pour…)
+    ne sont jamais une preuve ; l'avis du LLM (Justification) est lu de la même façon, mais etat_exclusion ne le
+    compte qu'à part. Une alternative (« Linux, macOS ou Windows », « Docker ou Podman ») n'est pas une exigence."""
+    if colonne in _COLONNES_VALEURS:
+        return 'mention'
+    if colonne != 'nom' and occurrence_niee(texte, a, b):
+        return 'non_requis'
+    debut, fin = _proposition(texte, a, b)
+    avant = _MOT_RE.findall(gn._fold(texte[debut:a]))
+    apres = _MOT_RE.findall(gn._fold(texte[b:fin]))
+    if (set(avant + apres) & lexique.SOUPLES or _SOUPLES_RE.search(' '.join(avant + ['|'] + apres))
+            or (nature == 'materiel' and 'cpu' in avant + apres)):
+        return 'non_requis'
+    contenu_avant = [m for m in avant if m not in lexique.MOTS_VIDES][-PORTEE_NEGATION:]
+    plie_avant = ' '.join(avant)
+    if set(contenu_avant) & _MARQUES_REFERENCE or any(e and e in plie_avant for e in _EXPRESSIONS_REFERENCE_PLIEES):
+        return 'non_requis'                     # « alternative open source à n8n » : il le remplace
+    if (avant[-1:] and avant[-1] in _DISJONCTIONS) or (apres[:1] and apres[0] in _DISJONCTIONS) \
+            or texte[a - 1:a] == '/' or texte[b:b + 1] == '/':
+        return 'mention'
+    contenu_apres = [m for m in apres if m not in lexique.MOTS_VIDES][:2]
+    if colonne == 'prerequis' or set(contenu_avant) & lexique.EXIGENCES or set(contenu_apres) & lexique.EXIGENCES:
+        return 'requis'
+    if nature == 'produit':
+        precedent = [m for m in avant if m not in _ARTICLES][-1:]
+        if precedent in (['pour'], ['for']) or set(contenu_avant[-1:] + contenu_apres[:1]) & lexique.ARTEFACTS:
+            return 'requis'                     # « modèles pour n8n », « workflows n8n », « skills for Claude Code »
+    return 'mention'
