+def _interdit_apres(unites: List[Tuple[Tuple[str, ...], str, Optional[str]]], k: int) -> bool:
+    """La technologie de la k-ième unité est suivie, avant toute autre technologie, d'une interdiction (« les
+    conteneurs sont interdits », « Docker is not allowed », « containers aren't allowed », « n'est pas autorisé »)."""
